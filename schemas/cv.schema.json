{
  "$id": "cv.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cv.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["variants"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "description": "One PDF per variant; the first is the main CV linked from the site",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "filename", "projects"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$" },
          "headline": { "$ref": "_defs.schema.json#/definitions/text" },
          "skills_first": { "type": "array", "items": { "type": "string" }, "description": "Skill-group titles from skills.yaml, listed first in this order" },
          "projects": { "type": "array", "items": { "type": "string" }, "description": "Exact names from projects.yaml" },
          "show_tech": { "type": "boolean" }
        }
      }
    }
  }
}
