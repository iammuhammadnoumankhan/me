{
  "$id": "research.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "venue", "publisher", "date"],
        "properties": {
          "title": { "$ref": "_defs.schema.json#/definitions/text" },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "_defs.schema.json#/definitions/text" }, "me": { "type": "boolean" } }
            }
          },
          "venue": { "$ref": "_defs.schema.json#/definitions/text" },
          "venue_full": { "$ref": "_defs.schema.json#/definitions/text" },
          "publisher": { "$ref": "_defs.schema.json#/definitions/text" },
          "date": { "$ref": "_defs.schema.json#/definitions/yearOrYearMonth" },
          "pages": { "$ref": "_defs.schema.json#/definitions/text" },
          "peer_reviewed": { "type": "boolean" },
          "collaboration": { "$ref": "_defs.schema.json#/definitions/text" },
          "topic": { "$ref": "_defs.schema.json#/definitions/text" },
          "url": { "$ref": "_defs.schema.json#/definitions/url" },
          "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
          "abstract": { "$ref": "_defs.schema.json#/definitions/text" }
        }
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "icon": { "$ref": "_defs.schema.json#/definitions/text" },
          "title": { "$ref": "_defs.schema.json#/definitions/text" },
          "description": { "$ref": "_defs.schema.json#/definitions/text" }
        }
      }
    }
  }
}
