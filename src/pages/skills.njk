---
layout: layouts/base.njk
pageId: skills
pageCss: skills
pageScripts: [skills]
permalink: /pages/skills.html
---
  {% include "components/page-hero.njk" %}

  <div class="band-mid">
  <div class="section">
    <div class="skills-page-grid">
      {%- for g in skills.groups %}
      <div class="skill-group reveal{% if loop.index <= 2 %} reveal-delay-{{ loop.index }}{% endif %}">
        <div class="sg-header">
          <div class="sg-icon" aria-hidden="true">{{ g.icon or "◆" }}</div>
          <div>
            <div class="sg-title">{{ g.title }}</div>
            {% if g.subtitle %}<div class="sg-sub">{{ g.subtitle }}</div>{% endif %}
          </div>
        </div>
        <div class="skill-chips">
          {%- for s in g.skills %}
          {%- if s.name %}
          <span class="skill-chip-lg{% if s.core %} star{% endif %}"><span class="dot"></span>{{ s.name }}</span>
          {%- else %}
          <span class="skill-chip-lg"><span class="dot"></span>{{ s }}</span>
          {%- endif %}
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>

    {%- if skills.proficiency and skills.proficiency.length %}
    <!-- Proficiency bars -->
    <div class="prof-wrap">
      <div class="section-eyebrow reveal">PROFICIENCY_OVERVIEW</div>
      <div class="prof-band reveal" id="prof-band">
        {%- for b in skills.proficiency %}
        <div class="pb-row">
          <div class="pb-label">{{ b.label }}</div>
          <div class="pb-bar" role="meter" aria-label="{{ b.label }}" aria-valuenow="{{ b.level }}" aria-valuemin="0" aria-valuemax="100"><div class="pb-fill" style="--w:{{ b.level }}%"></div></div>
          <div class="pb-pct">{{ b.level }}%</div>
        </div>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
  </div>
  </div>
