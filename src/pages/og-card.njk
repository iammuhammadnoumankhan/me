---
permalink: /og-card.html
eleventyExcludeFromCollections: true
---
{#- 1200×630 social preview card. Screenshotted to og-card.png after every production
    build (scripts/social-card.js) and used as og:image on every page. -#}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="robots" content="noindex">
<title>{{ profile.name }} — social card</title>
<style>
@font-face { font-family: 'Syne'; src: url('fonts/syne.woff2') format('woff2'); font-weight: 400 800; }
@font-face { font-family: 'DM Sans'; src: url('fonts/dm-sans.woff2') format('woff2'); font-weight: 300 700; }
@font-face { font-family: 'JetBrains Mono'; src: url('fonts/jetbrains-mono.woff2') format('woff2'); font-weight: 400 500; }
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: 1200px; height: 630px; overflow: hidden; }
body {
  position: relative;
  background: #0e0e0e;
  color: #e2e2e2;
  font-family: 'DM Sans', sans-serif;
  display: flex; align-items: center;
  padding: 0 72px;
  gap: 56px;
}
.glow { position: absolute; top: -260px; left: -200px; width: 900px; height: 900px;
  background: radial-gradient(ellipse, rgba(0,242,255,0.10) 0%, transparent 65%); }
.glow-2 { position: absolute; bottom: -300px; right: -200px; width: 700px; height: 700px;
  background: radial-gradient(ellipse, rgba(0,106,113,0.12) 0%, transparent 70%); }
.frame { position: absolute; inset: 0; border-bottom: 6px solid #00f2ff; opacity: 0.85; }
.text { position: relative; flex: 1; min-width: 0; }
.eyebrow {
  font-family: 'JetBrains Mono', monospace; font-size: 20px; color: #00f2ff;
  letter-spacing: 0.16em; text-transform: uppercase;
  display: flex; align-items: center; gap: 16px; margin-bottom: 28px;
}
.eyebrow::before { content: ''; width: 44px; height: 2px; background: #00f2ff; }
h1 {
  font-family: 'Syne', sans-serif; font-weight: 800;
  font-size: 64px; line-height: 1.04; letter-spacing: -0.025em;
}
h1 span {
  background: linear-gradient(135deg, #00f2ff 0%, #006a71 100%);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.role { font-family: 'Syne', sans-serif; font-weight: 500; font-size: 30px; color: #b8b8b8; margin-top: 26px; }
.url { font-family: 'JetBrains Mono', monospace; font-size: 20px; color: #8e8e8e; margin-top: 40px; letter-spacing: 0.04em; }
.photo {
  position: relative; flex-shrink: 0;
  width: 300px; height: 380px; border-radius: 28px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 0 90px rgba(0,242,255,0.10);
}
.photo img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
</style>
</head>
<body>
  <div class="glow"></div><div class="glow-2"></div><div class="frame"></div>
  <div class="text">
    <div class="eyebrow">{{ profile.roles | join(" · ") }}</div>
    <h1>{{ profile.first_name }}<br><span>{{ profile.last_name }}</span></h1>
    <div class="role">{{ cv.variants[0].headline or profile.headline }}</div>
    <div class="url">{{ site.url | displayUrl }}</div>
  </div>
  <div class="photo"><img src="img/{{ profile.photo | photoStem }}-600.jpeg" alt=""></div>
</body>
</html>
