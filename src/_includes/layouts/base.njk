{%- set meta = pages[pageId] -%}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ meta.title }}">
<meta property="og:description" content="{{ meta.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/og-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ profile.name }} — {{ cv.variants[0].headline or profile.headline }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}/og-card.png">
<link rel="icon" href="{{ '/favicon.svg' | rel(page.url) }}" type="image/svg+xml">
<link rel="icon" href="{{ '/favicon-32.png' | rel(page.url) }}" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | rel(page.url) }}">
<link rel="sitemap" type="application/xml" href="{{ '/sitemap.xml' | rel(page.url) }}">
<meta name="theme-color" content="#0e0e0e">
{%- if pageId == "home" %}
<script type="application/ld+json">{{ profile | personJsonLd(site, experience, education, skills) | safe }}</script>
{%- endif %}
<script>document.documentElement.classList.add('js')</script>
{#- Self-hosted fonts (see css/style.css); preloading the three upright faces avoids a layout shift when they swap in #}
<link rel="preload" href="{{ '/fonts/syne.woff2' | rel(page.url) }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/fonts/dm-sans.woff2' | rel(page.url) }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ '/fonts/jetbrains-mono.woff2' | rel(page.url) }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/css/style.css' | rel(page.url) }}">
{% if pageCss %}<link rel="stylesheet" href="{{ ('/css/pages/' + pageCss + '.css') | rel(page.url) }}">{% endif %}
</head>
<body>
{% include "components/nav.njk" %}
<main class="page-wrapper">
{{ content | safe }}
</main><!-- /page-wrapper -->
{% include "components/footer.njk" %}
<script src="{{ '/js/shared.js' | rel(page.url) }}"></script>
{%- if site.analytics and site.analytics.goatcounter %}
{#- GoatCounter count.v5.js pinned by its published SRI hash; links with data-goatcounter-click are counted as events #}
<script data-goatcounter="https://{{ site.analytics.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.v5.js" crossorigin="anonymous" integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"></script>
{%- endif %}
{%- for s in pageScripts %}
<script src="{{ ('/js/' + s + '.js') | rel(page.url) }}"></script>
{%- endfor %}
</body>
</html>
